{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "src/main.ts",
      "use": "@vercel/node@17.0.0",
      "config": {
        "includeFiles": [
          "node_modules/@nestjs/websockets/**",
          "node_modules/.pnpm/@nestjs+websockets@*/node_modules/@nestjs/websockets/**"
        ]
      }
    }
  ],
  "routes": [{ "src": "/(.*)", "dest": "/src/main.ts" }]
}
